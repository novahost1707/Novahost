# Basis-URL der Seite (fuer Canonicals, Sitemap, Open Graph, Links in den E-Mails)
NEXT_PUBLIC_SITE_URL="https://nova-host.org"

# Kontaktdaten, die in Footer / Legal ausgegeben werden.
# Leer lassen, solange keine echten Daten vorliegen - dann werden sie ausgeblendet.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""

# ------------------------------------------------------------------
# Zustellung der Leads
# Ohne Konfiguration wird die Anfrage nur serverseitig geloggt.
# ------------------------------------------------------------------

# Postfach, in dem BEIDE Formulare ankommen.
LEAD_MAIL_TO="deine-adresse@example.com"

# Formular 1: kostenlose Website-Analyse
RESEND_API_KEY_ANALYSE=""
LEAD_MAIL_FROM_ANALYSE="Novahost Analyse <analyse@nova-host.org>"

# Formular 2: Erstgespraech / Projektanfrage
RESEND_API_KEY_PROJEKT=""
LEAD_MAIL_FROM_PROJEKT="Novahost <anfrage@nova-host.org>"

# Ersatzwerte, falls die beiden Formulare denselben Schluessel nutzen sollen.
# Werden nur herangezogen, wenn die getrennten Variablen oben leer sind.
RESEND_API_KEY=""
LEAD_MAIL_FROM=""

# Optional zusaetzlich: beliebiger Webhook (z. B. Make, n8n, Zapier, eigenes CRM)
LEAD_WEBHOOK_URL=""
