# Vorlage fuer lokale Entwicklung: Datei nach .env.local kopieren und ausfuellen.
# Diese Datei enthaelt NIEMALS echte Keys — .env.local ist per .gitignore ausgeschlossen.

# Resend API Key (https://resend.com/api-keys).
# Wird ausschliesslich serverseitig in app/api/contact/route.ts gelesen.
# Auf Vercel unter Settings -> Environment Variables hinterlegen.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Empfaenger der Kontaktanfragen.
# Ohne Angabe wird hello@novahost.dev verwendet.
CONTACT_EMAIL_TO=hello@novahost.dev

# Optional: Basis-URL fuer Metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.novahost.dev
