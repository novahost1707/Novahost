# Basis-URL der Seite (fuer Canonicals, Sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://novahost.de"

# Kontaktdaten, die in Footer / Legal ausgegeben werden.
# Leer lassen, solange keine echten Daten vorliegen - dann werden sie ausgeblendet.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""

# Zustellung der Leads. Ohne Konfiguration wird die Anfrage nur serverseitig geloggt.
# Variante A: Resend (https://resend.com) - REST, keine zusaetzliche Dependency.
RESEND_API_KEY=""
LEAD_MAIL_FROM=""
LEAD_MAIL_TO=""

# Variante B: beliebiger Webhook (z. B. Make, n8n, Zapier, eigenes CRM)
LEAD_WEBHOOK_URL=""
